{inputs, ...}: let
  lib = inputs.nixpkgs.lib;

  # Host metadata only — no nixosConfiguration is evaluated.
  LT = import ../helpers {
    inherit lib inputs;
  };

  rules = lib.concatMapAttrs (_: host:
    lib.mapAttrs' (
      file: _: lib.nameValuePair "${host.secretsDir}/${file}" {publicKeys = host.trustedKeys;}
    ) (LT.secrets.discover host.secretsPath))
  LT.hosts;
in {
  # `just secrets-rules` writes this to agenix-rules.nix, which agenix reads from
  # the repo root (paths above are relative to it).
  flake.agenixRules =
    "# Generated by `just secrets-rules` from hosts/*/host.nix and helpers/keys.nix. Do not edit.\n"
    + lib.generators.toPretty {} rules;

  # Pinned agenix CLI for the `secrets-*` recipes.
  perSystem = {system, ...}: {
    packages.agenix = inputs.agenix.packages.${system}.default;
  };
}
